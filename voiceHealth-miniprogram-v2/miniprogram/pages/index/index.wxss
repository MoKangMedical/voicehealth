/* pages/index/index.wxss */
.container {
  padding: 0 28rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* Header */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 0 20rpx;
}

.logo {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.logo-icon {
  font-size: 48rpx;
}

.logo-text {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.1);
}

/* Mobile Quick Panel */
.mobile-panel {
  background: rgba(255,255,255,0.045);
  border: 1rpx solid rgba(255,255,255,0.07);
  border-radius: 24rpx;
  padding: 20rpx;
  margin: 18rpx 0 24rpx;
}

.dashboard-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.dash-item {
  min-height: 96rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.045);
  border: 1rpx solid rgba(255,255,255,0.06);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 14rpx;
  box-sizing: border-box;
}

.dash-item.ok {
  background: rgba(34,197,94,0.10);
  border-color: rgba(34,197,94,0.22);
}

.dash-item.attention {
  background: rgba(245,158,11,0.11);
  border-color: rgba(245,158,11,0.24);
}

.dash-value {
  display: block;
  max-width: 100%;
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dash-label {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.2;
  color: rgba(255,255,255,0.45);
}

.thumb-actions {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.thumb-btn {
  min-height: 104rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.055);
  border: 1rpx solid rgba(255,255,255,0.07);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.thumb-btn.primary {
  background: rgba(59,130,246,0.18);
  border-color: rgba(59,130,246,0.34);
}

.thumb-btn.recording {
  background: rgba(239,68,68,0.18);
  border-color: rgba(239,68,68,0.34);
}

.thumb-btn:active,
.dash-item:active {
  transform: scale(0.98);
  background: rgba(255,255,255,0.09);
}

.thumb-icon {
  font-size: 34rpx;
}

.thumb-text {
  font-size: 23rpx;
  color: rgba(255,255,255,0.75);
}

/* Main Card */
.main-card {
  background: linear-gradient(135deg, rgba(59,130,246,0.08), rgba(34,197,94,0.06));
  border: 1rpx solid rgba(59,130,246,0.15);
  border-radius: 32rpx;
  padding: 40rpx 28rpx;
  margin: 24rpx 0 32rpx;
  text-align: center;
}

.card-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.card-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.45);
  margin-bottom: 48rpx;
}

/* Reading Text Section */
.reading-section {
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
  text-align: left;
}

.reading-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.reading-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.65);
  font-weight: 500;
}

.refresh-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: rgba(59,130,246,0.15);
  border-radius: 12rpx;
}

.refresh-icon {
  font-size: 24rpx;
}

.refresh-text {
  font-size: 22rpx;
  color: #3b82f6;
}

.reading-text-box {
  background: rgba(0,0,0,0.2);
  border-radius: 12rpx;
  padding: 20rpx;
}

.reading-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: rgba(255,255,255,0.9);
}

/* Record Button */
.record-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.record-btn {
  width: 188rpx;
  height: 188rpx;
  border-radius: 50%;
  background: rgba(59,130,246,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.3s ease;
}

.record-btn.recording {
  background: rgba(239,68,68,0.2);
}

.record-btn-inner {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: #3b82f6;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.record-btn.recording .record-btn-inner {
  background: #ef4444;
}

.record-icon {
  font-size: 64rpx;
}

.record-ripple {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid rgba(239,68,68,0.3);
  animation: ripple 1.5s infinite;
}

@keyframes ripple {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(1.5); opacity: 0; }
}

.record-time {
  font-size: 46rpx;
  font-weight: 300;
  margin: 24rpx 0 8rpx;
  font-variant-numeric: tabular-nums;
}

.record-hint {
  font-size: 24rpx;
  color: rgba(255,255,255,0.45);
}

/* Analyze Button */
.btn-analyze {
  width: 100%;
  height: 96rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}

.btn-analyze[disabled] {
  background: rgba(59,130,246,0.3);
  color: rgba(255,255,255,0.3);
}

.free-info {
  font-size: 24rpx;
}

/* Features Grid */
.features-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.feature-item {
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 24rpx;
  padding: 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.feature-item:active,
.tool-item:active {
  background: rgba(255,255,255,0.08);
  transform: scale(0.98);
}

.feature-icon {
  font-size: 48rpx;
}

.feature-name {
  font-size: 28rpx;
  font-weight: 600;
}

.feature-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.45);
}

.tools-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
}

.tool-item {
  min-height: 120rpx;
  padding: 18rpx 8rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.tool-icon {
  font-size: 34rpx;
}

.tool-name {
  max-width: 100%;
  font-size: 22rpx;
  line-height: 1.2;
  color: rgba(255,255,255,0.68);
  white-space: nowrap;
}

/* Tips */
.tips-card {
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 24rpx;
  padding: 32rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-dot {
  color: #3b82f6;
  font-size: 28rpx;
}

.tip-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.65);
  line-height: 1.6;
}

/* Disclaimer */
.disclaimer {
  font-size: 22rpx;
  color: rgba(255,255,255,0.25);
  text-align: center;
  padding: 40rpx 20rpx;
  line-height: 1.6;
}

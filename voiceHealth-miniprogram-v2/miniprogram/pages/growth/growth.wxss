.container {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.hero {
  padding: 36rpx 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(15,23,42,0.96), rgba(30,41,59,0.9));
  border: 1rpx solid rgba(96,165,250,0.22);
  margin-bottom: 22rpx;
}

.hero-label {
  display: block;
  color: #93c5fd;
  font-size: 22rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.hero-title {
  display: block;
  color: #fff;
  font-size: 44rpx;
  line-height: 1.15;
  font-weight: 900;
}

.hero-subtitle {
  display: block;
  margin-top: 14rpx;
  color: rgba(255,255,255,0.62);
  font-size: 25rpx;
  line-height: 1.55;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 26rpx;
}

.metric-card {
  min-height: 110rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.045);
  border: 1rpx solid rgba(255,255,255,0.07);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 12rpx 8rpx;
  box-sizing: border-box;
}

.metric-value {
  font-size: 30rpx;
  color: #fff;
  font-weight: 900;
}

.metric-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,0.44);
}

.section {
  margin-bottom: 28rpx;
}

.section-head {
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  color: #fff;
  font-size: 32rpx;
  font-weight: 900;
}

.section-desc {
  display: block;
  margin-top: 8rpx;
  color: rgba(255,255,255,0.48);
  font-size: 23rpx;
  line-height: 1.45;
}

.offer-card,
.channel-card,
.script-card,
.compliance-card {
  padding: 22rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.045);
  border: 1rpx solid rgba(255,255,255,0.07);
  margin-bottom: 14rpx;
}

.offer-top,
.channel-top,
.script-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.offer-title,
.channel-name,
.script-title {
  color: #fff;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 850;
  flex: 1;
  min-width: 0;
}

.offer-price {
  color: #93c5fd;
  font-size: 25rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.offer-audience,
.channel-goal {
  display: block;
  margin-top: 8rpx;
  color: rgba(255,255,255,0.58);
  font-size: 23rpx;
  line-height: 1.45;
}

.point-row,
.compliance-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 12rpx;
  color: rgba(255,255,255,0.62);
  font-size: 23rpx;
  line-height: 1.45;
}

.point-dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #60a5fa;
  flex-shrink: 0;
}

.point-text {
  flex: 1;
  min-width: 0;
}

.channel-line {
  display: block;
  margin-top: 10rpx;
  color: rgba(255,255,255,0.48);
  font-size: 22rpx;
  line-height: 1.5;
}

.copy-btn {
  width: 92rpx;
  height: 48rpx;
  padding: 0;
  margin: 0;
  border-radius: 999rpx;
  background: rgba(96,165,250,0.16);
  border: 1rpx solid rgba(96,165,250,0.24);
  color: #bfdbfe;
  font-size: 22rpx;
  line-height: 48rpx;
  flex-shrink: 0;
}

.copy-btn::after,
.contact-btn::after,
.share-btn::after {
  border: none;
}

.script-body {
  display: block;
  margin-top: 14rpx;
  color: rgba(255,255,255,0.58);
  font-size: 23rpx;
  line-height: 1.58;
}

.launch-card {
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(15,23,42,0.64);
  border: 1rpx solid rgba(134,239,172,0.14);
  margin-bottom: 12rpx;
}

.launch-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.launch-day {
  width: 70rpx;
  color: #86efac;
  font-size: 24rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.launch-channel {
  flex: 1;
  min-width: 0;
  color: rgba(255,255,255,0.6);
  font-size: 22rpx;
}

.launch-title {
  display: block;
  margin-top: 12rpx;
  color: #fff;
  font-size: 26rpx;
  line-height: 1.42;
  font-weight: 850;
}

.launch-asset {
  display: block;
  margin-top: 8rpx;
  color: rgba(255,255,255,0.42);
  font-size: 21rpx;
  line-height: 1.4;
}

.launch-caption {
  display: block;
  margin-top: 8rpx;
  color: rgba(255,255,255,0.5);
  font-size: 22rpx;
  line-height: 1.5;
}

.check {
  width: 30rpx;
  color: #86efac;
  font-weight: 900;
  flex-shrink: 0;
}

.contact-btn,
.share-btn {
  height: 88rpx;
  margin: 18rpx 0 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 850;
}

.contact-btn {
  color: #08111f;
  background: #93c5fd;
}

.share-btn {
  color: #bfdbfe;
  background: rgba(96,165,250,0.14);
  border: 1rpx solid rgba(96,165,250,0.22);
}

.container {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.page-header {
  margin: 20rpx 0 28rpx;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
}

.page-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.46);
}

.filter-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.filter-item {
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.045);
  color: rgba(255,255,255,0.56);
  font-size: 25rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
}

.filter-item.active {
  color: #fff;
  background: rgba(59,130,246,0.22);
  border-color: rgba(59,130,246,0.45);
}

.loading-wrap,
.error-wrap,
.empty-state {
  min-height: 55vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  text-align: center;
  color: rgba(255,255,255,0.52);
}

.loading-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 5rpx solid rgba(255,255,255,0.12);
  border-top-color: #3b82f6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.empty-icon {
  font-size: 64rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.empty-desc {
  font-size: 25rpx;
}

.empty-btn,
.retry-btn {
  margin-top: 16rpx;
  min-width: 220rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: #3b82f6;
  color: #fff;
  font-size: 28rpx;
  line-height: 76rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.045);
  border: 1rpx solid rgba(255,255,255,0.07);
}

.score-ring {
  width: 92rpx;
  height: 92rpx;
  border: 5rpx solid #3b82f6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.score {
  font-size: 30rpx;
  font-weight: 800;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.record-summary {
  flex: 1;
  min-width: 0;
  color: #f8fafc;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.4;
}

.type-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 42rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.06);
  color: rgba(255,255,255,0.66);
  font-size: 22rpx;
  flex-shrink: 0;
}

.record-meta {
  display: flex;
  gap: 18rpx;
  margin-top: 12rpx;
  font-size: 23rpx;
  color: rgba(255,255,255,0.42);
}

.arrow {
  color: rgba(255,255,255,0.25);
  font-size: 44rpx;
}

.load-more {
  min-height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  color: rgba(255,255,255,0.32);
  font-size: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

<view class="container">
  <view class="page-header">
    <text class="page-title">检测记录</text>
    <text class="page-subtitle">按时间查看语音、面部和视频报告</text>
  </view>

  <view class="filter-bar">
    <view class="filter-item {{filterType === item.type ? 'active' : ''}}"
          wx:for="{{filters}}"
          wx:key="type"
          data-type="{{item.type}}"
          bindtap="switchFilter">
      <text>{{item.text}}</text>
    </view>
  </view>

  <view class="loading-wrap" wx:if="{{loading && records.length === 0}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <view class="error-wrap" wx:if="{{!loading && error && records.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-title">{{errorMsg || '暂无检测记录'}}</text>
    <button class="btn btn-primary retry-btn" bindtap="retryLoad">重新加载</button>
  </view>

  <view class="empty-state" wx:if="{{!loading && !error && records.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-title">暂无检测记录</text>
    <text class="empty-desc">完成一次检测后，报告会显示在这里</text>
    <navigator class="empty-btn" open-type="switchTab" url="/pages/index/index">去检测</navigator>
  </view>

  <view class="record-list" wx:if="{{records.length > 0}}">
    <view class="record-item" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="goReport">
      <view class="score-ring" style="border-color: {{item.scoreColor}}">
        <text class="score" style="color: {{item.scoreColor}}">{{item.score}}</text>
      </view>
      <view class="record-main">
        <view class="record-title-row">
          <text class="record-summary">{{item.summary}}</text>
          <view class="type-badge">
            <text>{{item.typeIcon}}</text>
            <text>{{item.typeText}}</text>
          </view>
        </view>
        <view class="record-meta">
          <text style="color: {{item.scoreColor}}">{{item.scoreLevel}}</text>
          <text>{{item.date}}</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="load-more" wx:if="{{records.length > 0}}">
    <text wx:if="{{loading}}">加载中...</text>
    <text wx:elif="{{!hasMore}}">已加载全部记录</text>
  </view>
</view>

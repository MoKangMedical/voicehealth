/* pages/combined/combined.wxss */
.container { padding: 32rpx; min-height: 100vh; }
.header { text-align: center; margin-bottom: 40rpx; }
.title { font-size: 40rpx; font-weight: 700; display: block; }
.subtitle { font-size: 26rpx; color: rgba(255,255,255,0.45); }

.sources { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; margin-bottom: 24rpx; }
.source-item { min-height: 154rpx; background: rgba(255,255,255,0.04); border: 2rpx solid rgba(255,255,255,0.06); border-radius: 20rpx; padding: 20rpx 12rpx; text-align: center; box-sizing: border-box; }
.source-item.active { border-color: #3b82f6; background: rgba(59,130,246,0.1); }
.source-icon { font-size: 40rpx; display: block; margin-bottom: 12rpx; }
.source-name { font-size: 26rpx; font-weight: 600; display: block; margin-bottom: 8rpx; }
.source-status { font-size: 20rpx; line-height: 1.35; color: rgba(255,255,255,0.45); }
.source-item.active .source-status { color: #3b82f6; }

.source-actions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; margin-bottom: 26rpx; }
.mini-btn { height: 68rpx; line-height: 68rpx; padding: 0; border-radius: 16rpx; background: rgba(255,255,255,0.055); color: rgba(255,255,255,0.72); font-size: 24rpx; border: 1rpx solid rgba(255,255,255,0.08); }
.mini-btn::after { border: none; }

.action-section { text-align: center; padding: 42rpx 0 60rpx; }
.btn-large { height: 112rpx; font-size: 32rpx; }
.action-hint { font-size: 24rpx; color: rgba(255,255,255,0.45); display: block; margin-top: 20rpx; }

.overall-score { display: flex; justify-content: center; gap: 60rpx; margin-bottom: 40rpx; }
.score-ring, .age-ring { width: 200rpx; height: 200rpx; border-radius: 50%; border: 8rpx solid; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.score-number, .age-number { font-size: 48rpx; font-weight: 700; }
.score-text, .age-text { font-size: 22rpx; color: rgba(255,255,255,0.45); }

.dimensions-card { background: rgba(255,255,255,0.04); border-radius: 20rpx; padding: 24rpx; margin-bottom: 24rpx; }
.card-title { font-size: 28rpx; font-weight: 600; display: block; margin-bottom: 20rpx; }
.dimensions-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20rpx; }
.dimension { text-align: center; }
.dim-icon { font-size: 36rpx; display: block; margin-bottom: 8rpx; }
.dim-name { font-size: 22rpx; color: rgba(255,255,255,0.65); display: block; margin-bottom: 8rpx; }
.dim-score { font-size: 32rpx; font-weight: 700; }

.summary-card, .suggestions-card { background: rgba(255,255,255,0.04); border-radius: 20rpx; padding: 24rpx; margin-bottom: 24rpx; }
.summary-text { font-size: 26rpx; color: rgba(255,255,255,0.65); line-height: 1.6; }

.suggestion { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 16rpx; }
.suggestion-num { width: 40rpx; height: 40rpx; border-radius: 50%; background: #3b82f6; display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 700; flex-shrink: 0; }
.suggestion-text { font-size: 26rpx; color: rgba(255,255,255,0.65); line-height: 1.6; }

.result-actions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-top: 40rpx; }
.result-actions .btn { flex: 1; }
.btn-share { background: rgba(59,130,246,0.18); color: #bfdbfe; border: 1rpx solid rgba(59,130,246,0.28); }

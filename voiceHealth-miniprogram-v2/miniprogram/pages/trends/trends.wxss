.container {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 28rpx;
}

.page-title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  color: #fff;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: rgba(255,255,255,0.45);
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.summary-card {
  min-height: 130rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.045);
  border: 1rpx solid rgba(255,255,255,0.07);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.summary-value {
  font-size: 42rpx;
  font-weight: 800;
  color: #93c5fd;
}

.summary-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.45);
}

.trend-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.trend-item {
  padding: 26rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.045);
  border: 1rpx solid rgba(255,255,255,0.07);
}

.trend-top,
.trend-score-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trend-type {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.78);
}

.trend-date,
.trend-level {
  font-size: 23rpx;
  color: rgba(255,255,255,0.42);
}

.trend-score-row {
  margin: 18rpx 0 12rpx;
}

.trend-score {
  font-size: 44rpx;
  font-weight: 800;
}

.bar-track {
  height: 14rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255,255,255,0.09);
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
}

.loading-wrap,
.error-wrap,
.empty-state {
  min-height: 55vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid rgba(255,255,255,0.12);
  border-top-color: #3b82f6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-icon {
  font-size: 64rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.empty-desc {
  font-size: 25rpx;
  color: rgba(255,255,255,0.45);
}

.empty-btn,
.retry-btn {
  width: 240rpx;
}

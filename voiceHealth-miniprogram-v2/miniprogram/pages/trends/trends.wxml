<view class="container">
  <view class="page-header">
    <text class="page-title">趋势分析</text>
    <text class="page-subtitle">近{{days}}天语音、面部、视频和综合报告走势</text>
  </view>

  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载趋势中...</text>
  </view>

  <view class="error-wrap" wx:if="{{!loading && error}}">
    <text class="empty-icon">📈</text>
    <text class="empty-title">趋势加载失败</text>
    <button class="btn btn-primary retry-btn" bindtap="retryLoad">重新加载</button>
  </view>

  <block wx:if="{{!loading && !error}}">
    <view class="summary-grid">
      <view class="summary-card">
        <text class="summary-value">{{latestScore}}</text>
        <text class="summary-label">最近评分</text>
      </view>
      <view class="summary-card">
        <text class="summary-value">{{avgScore}}</text>
        <text class="summary-label">平均评分</text>
      </view>
      <view class="summary-card">
        <text class="summary-value">{{bestScore}}</text>
        <text class="summary-label">最佳评分</text>
      </view>
    </view>

    <view class="empty-state" wx:if="{{trends.length === 0}}">
      <text class="empty-icon">📈</text>
      <text class="empty-title">暂无趋势数据</text>
      <text class="empty-desc">完成检测后会自动生成趋势记录</text>
      <navigator class="empty-btn" open-type="switchTab" url="/pages/index/index">去检测</navigator>
    </view>

    <view class="trend-list" wx:if="{{trends.length > 0}}">
      <view class="trend-item" wx:for="{{trends}}" wx:key="index">
        <view class="trend-top">
          <view class="trend-type">
            <text>{{item.icon}}</text>
            <text>{{item.typeText}}</text>
          </view>
          <text class="trend-date">{{item.date}}</text>
        </view>
        <view class="trend-score-row">
          <text class="trend-score" style="color: {{item.color}}">{{item.score}}</text>
          <text class="trend-level">{{item.levelText}}</text>
        </view>
        <view class="bar-track">
          <view class="bar-fill" style="width: {{item.barWidth}}; background: {{item.color}}"></view>
        </view>
      </view>
    </view>
  </block>
</view>

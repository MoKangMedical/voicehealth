/* pages/video/video.wxss */
.container { min-height: 100vh; }

.camera { width: 100%; height: 500rpx; position: relative; }
.recording-overlay { position: absolute; top: 20rpx; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 12rpx; padding: 12rpx 24rpx; background: rgba(239,68,68,0.8); border-radius: 30rpx; }
.recording-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #fff; animation: blink 1s infinite; }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }
.recording-time { font-size: 28rpx; color: #fff; }

.camera-controls { display: flex; justify-content: space-around; align-items: center; padding: 30rpx; background: rgba(255,255,255,0.05); }
.control-btn { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; }
.control-btn.placeholder { visibility: hidden; }
.record-btn { width: 100rpx; height: 100rpx; border-radius: 50%; background: rgba(255,255,255,0.2); border: 4rpx solid #fff; display: flex; align-items: center; justify-content: center; }
.record-btn.recording { border-color: #ef4444; }
.record-inner { width: 80rpx; height: 80rpx; border-radius: 50%; background: #ef4444; }

.detect-section { padding: 24rpx 32rpx; }
.section-title { font-size: 26rpx; font-weight: 600; color: rgba(255,255,255,0.45); display: block; margin-bottom: 16rpx; }
.detect-items { display: flex; gap: 16rpx; }
.detect-item { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 16rpx; background: rgba(255,255,255,0.04); border-radius: 16rpx; }
.detect-item.active { background: rgba(59,130,246,0.1); }
.detect-icon { font-size: 32rpx; margin-bottom: 8rpx; }
.detect-name { font-size: 22rpx; margin-bottom: 8rpx; }
.detect-check { font-size: 20rpx; color: #3b82f6; }

.preview-section { padding: 32rpx; }
.preview-video { width: 100%; height: 400rpx; border-radius: 16rpx; }
.preview-actions { display: flex; gap: 20rpx; margin-top: 30rpx; }
.preview-actions .btn { flex: 1; }

.analyzing-section { padding: 100rpx 32rpx; }
.analyzing-card { background: rgba(255,255,255,0.04); border-radius: 24rpx; padding: 60rpx; text-align: center; }
.analyzing-icon { font-size: 80rpx; display: block; margin-bottom: 24rpx; }
.analyzing-title { font-size: 36rpx; font-weight: 600; display: block; margin-bottom: 30rpx; }
.progress-bar { height: 12rpx; background: rgba(255,255,255,0.1); border-radius: 6rpx; overflow: hidden; margin-bottom: 16rpx; }
.progress-fill { height: 100%; background: #3b82f6; border-radius: 6rpx; transition: width 0.3s; }
.progress-text { font-size: 24rpx; color: rgba(255,255,255,0.45); }

.result-section { padding: 32rpx; }
.result-header { display: flex; align-items: center; justify-content: space-around; background: rgba(255,255,255,0.04); border-radius: 24rpx; padding: 40rpx; margin-bottom: 30rpx; }
.score-circle { width: 160rpx; height: 160rpx; border-radius: 50%; border: 8rpx solid; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.score-value { font-size: 48rpx; font-weight: 700; }
.score-label { font-size: 22rpx; color: rgba(255,255,255,0.45); }
.age-info { text-align: center; }
.age-label { font-size: 24rpx; color: rgba(255,255,255,0.45); display: block; }
.age-value { font-size: 40rpx; font-weight: 600; }

.result-cards { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 30rpx; }
.result-card { background: rgba(255,255,255,0.04); border-radius: 16rpx; padding: 24rpx; display: flex; align-items: center; gap: 16rpx; }
.card-icon { font-size: 36rpx; }
.card-title { font-size: 28rpx; font-weight: 600; flex: 1; }
.card-score { font-size: 28rpx; font-weight: 700; }
.card-summary { font-size: 24rpx; color: rgba(255,255,255,0.45); width: 100%; margin-top: 8rpx; }

.result-actions { display: flex; gap: 20rpx; }
.result-actions .btn { flex: 1; }

/* pages/face/face.wxss */
.container { min-height: 100vh; }

.photo-section { position: relative; }
.camera { width: 100%; height: 750rpx; }
.camera-guide { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; }
.guide-face { width: 300rpx; height: 400rpx; border: 2rpx solid rgba(255,255,255,0.5); border-radius: 150rpx; margin-bottom: 16rpx; }
.guide-text { font-size: 24rpx; color: rgba(255,255,255,0.8); }

.camera-actions { display: flex; justify-content: space-around; align-items: center; padding: 40rpx 60rpx; background: rgba(255,255,255,0.05); }
.action-btn { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.action-text { font-size: 22rpx; color: rgba(255,255,255,0.6); }
.capture-btn { width: 120rpx; height: 120rpx; border-radius: 50%; background: rgba(255,255,255,0.2); border: 4rpx solid #fff; display: flex; align-items: center; justify-content: center; }
.capture-inner { width: 96rpx; height: 96rpx; border-radius: 50%; background: #fff; }

.preview-section { padding: 32rpx; }
.preview-image { width: 100%; height: 600rpx; border-radius: 20rpx; }
.preview-actions { display: flex; gap: 20rpx; margin-top: 30rpx; }
.preview-actions .btn { flex: 1; }

.result-section { padding: 32rpx; }
.result-header { display: flex; align-items: center; justify-content: space-around; background: rgba(255,255,255,0.04); border-radius: 24rpx; padding: 40rpx; margin-bottom: 30rpx; }
.score-circle { width: 160rpx; height: 160rpx; border-radius: 50%; border: 8rpx solid; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.score-value { font-size: 48rpx; font-weight: 700; }
.score-label { font-size: 22rpx; color: rgba(255,255,255,0.45); }
.age-info { text-align: center; }
.age-label { font-size: 24rpx; color: rgba(255,255,255,0.45); display: block; }
.age-value { font-size: 40rpx; font-weight: 600; }

.dimensions { background: rgba(255,255,255,0.04); border-radius: 20rpx; padding: 24rpx; margin-bottom: 24rpx; }
.dimension-item { display: flex; align-items: center; flex-wrap: wrap; padding: 16rpx 0; }
.dim-name { width: 120rpx; font-size: 26rpx; }
.dim-bar { flex: 1; height: 16rpx; background: rgba(255,255,255,0.1); border-radius: 8rpx; margin: 0 16rpx; overflow: hidden; }
.dim-fill { height: 100%; border-radius: 8rpx; transition: width 0.5s; }
.dim-score { width: 60rpx; text-align: right; font-size: 26rpx; font-weight: 600; }
.dim-detail { width: 100%; margin: 8rpx 0 0 120rpx; font-size: 22rpx; color: rgba(255,255,255,0.42); }

.summary-card { background: rgba(255,255,255,0.04); border-radius: 20rpx; padding: 24rpx; margin-bottom: 24rpx; }
.summary-title { font-size: 26rpx; font-weight: 600; display: block; margin-bottom: 12rpx; }
.summary-text { font-size: 26rpx; color: rgba(255,255,255,0.65); line-height: 1.6; }

.suggestions { background: rgba(255,255,255,0.04); border-radius: 20rpx; padding: 24rpx; margin-bottom: 30rpx; }
.suggestions-title { font-size: 26rpx; font-weight: 600; display: block; margin-bottom: 16rpx; }
.suggestion-item { display: flex; align-items: flex-start; gap: 12rpx; margin-bottom: 12rpx; }
.suggestion-dot { color: #3b82f6; }
.suggestion-text { font-size: 24rpx; color: rgba(255,255,255,0.65); line-height: 1.6; }

.result-actions { display: flex; gap: 20rpx; }
.result-actions .btn { flex: 1; }

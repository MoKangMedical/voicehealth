<view class="container">
  <view class="page-header">
    <text class="page-title">会员与订单</text>
    <text class="page-subtitle">查看购买记录和会员服务</text>
  </view>

  <view class="vip-card">
    <view>
      <text class="vip-title">月度会员</text>
      <text class="vip-desc">不限次数生成健康参考报告</text>
    </view>
    <view class="vip-price">
      <text class="price-symbol">¥</text>
      <text class="price-number">29.9</text>
    </view>
    <button class="btn btn-pay vip-btn" bindtap="buyVip">开通会员</button>
  </view>

  <view class="price-row" bindtap="showPricing">
    <text>查看完整价格说明</text>
    <text>›</text>
  </view>

  <view class="section-title">订单记录</view>

  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载订单中...</text>
  </view>

  <view class="error-wrap" wx:if="{{!loading && error}}">
    <text class="empty-icon">🧾</text>
    <text class="empty-title">订单加载失败</text>
    <button class="btn btn-primary retry-btn" bindtap="retryLoad">重新加载</button>
  </view>

  <view class="empty-state" wx:if="{{!loading && !error && orders.length === 0}}">
    <text class="empty-icon">🧾</text>
    <text class="empty-title">暂无订单</text>
    <text class="empty-desc">开通会员后订单会显示在这里</text>
  </view>

  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="order-item" wx:for="{{orders}}" wx:key="id">
      <view class="order-top">
        <text class="order-type">{{item.typeText}}</text>
        <text class="order-status {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="order-main">
        <text class="order-no">{{item.order_no}}</text>
        <text class="order-amount">{{item.amountText}}</text>
      </view>
      <text class="order-date">{{item.dateText}}</text>
    </view>
  </view>
</view>

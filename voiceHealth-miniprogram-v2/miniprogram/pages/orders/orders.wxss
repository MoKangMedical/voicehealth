.container {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 28rpx;
}

.page-title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  color: #fff;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: rgba(255,255,255,0.45);
}

.vip-card {
  padding: 30rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(250,204,21,0.20), rgba(249,115,22,0.10));
  border: 1rpx solid rgba(250,204,21,0.22);
}

.vip-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #fff7ed;
}

.vip-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: rgba(255,255,255,0.62);
}

.vip-price {
  margin: 28rpx 0 24rpx;
}

.price-symbol {
  font-size: 30rpx;
  color: #fde68a;
}

.price-number {
  font-size: 64rpx;
  font-weight: 850;
  color: #facc15;
}

.vip-btn {
  width: 100%;
}

.price-row {
  height: 92rpx;
  margin: 22rpx 0 34rpx;
  padding: 0 26rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.045);
  border: 1rpx solid rgba(255,255,255,0.07);
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255,255,255,0.78);
  font-size: 27rpx;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-item {
  padding: 26rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.045);
  border: 1rpx solid rgba(255,255,255,0.07);
}

.order-top,
.order-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.order-type {
  font-size: 29rpx;
  font-weight: 700;
  color: #fff;
}

.order-status {
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 42rpx;
  color: #93c5fd;
  background: rgba(59,130,246,0.12);
}

.order-status.paid {
  color: #86efac;
  background: rgba(34,197,94,0.12);
}

.order-status.pending {
  color: #fde68a;
  background: rgba(234,179,8,0.12);
}

.order-main {
  margin: 18rpx 0 10rpx;
}

.order-no {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 23rpx;
  color: rgba(255,255,255,0.42);
}

.order-amount {
  font-size: 32rpx;
  font-weight: 800;
  color: #facc15;
}

.order-date {
  font-size: 23rpx;
  color: rgba(255,255,255,0.38);
}

.loading-wrap,
.error-wrap,
.empty-state {
  min-height: 38vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid rgba(255,255,255,0.12);
  border-top-color: #3b82f6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-icon {
  font-size: 64rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.empty-desc {
  font-size: 25rpx;
  color: rgba(255,255,255,0.45);
}

.retry-btn {
  width: 240rpx;
}

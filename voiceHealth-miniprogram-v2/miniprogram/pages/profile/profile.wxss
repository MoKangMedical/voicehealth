.container {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx;
  margin-top: 20rpx;
  border-radius: 26rpx;
  background: rgba(255,255,255,0.045);
  border: 1rpx solid rgba(255,255,255,0.08);
}

.avatar-btn {
  width: 132rpx;
  height: 132rpx;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar,
.avatar-placeholder {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(59,130,246,0.16);
  font-size: 52rpx;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.nickname-input {
  height: 48rpx;
  padding: 0;
  color: #fff;
  font-size: 34rpx;
  font-weight: 750;
}

.user-id {
  display: block;
  margin-top: 8rpx;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: rgba(255,255,255,0.34);
  font-size: 20rpx;
}

.login-btn {
  width: 220rpx;
  height: 60rpx;
  margin: 14rpx 0 0;
  border-radius: 14rpx;
  background: #3b82f6;
  color: #fff;
  font-size: 24rpx;
  line-height: 60rpx;
}

.vip-tag {
  display: inline-flex;
  margin-top: 14rpx;
  min-height: 44rpx;
  align-items: center;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.06);
  color: rgba(255,255,255,0.66);
  font-size: 23rpx;
}

.vip-tag.active {
  background: linear-gradient(135deg, #facc15, #f97316);
  color: #111827;
  font-weight: 700;
}

.vip-expire {
  display: block;
  margin-top: 8rpx;
  color: rgba(255,255,255,0.42);
  font-size: 22rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin: 28rpx 0;
}

.stat-card {
  min-height: 116rpx;
  padding: 18rpx 10rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.045);
  border: 1rpx solid rgba(255,255,255,0.07);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 800;
  color: #93c5fd;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: rgba(255,255,255,0.45);
}

.type-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-bottom: 34rpx;
}

.type-item {
  padding: 20rpx 10rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.06);
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.type-icon {
  font-size: 28rpx;
}

.type-name {
  font-size: 22rpx;
  color: rgba(255,255,255,0.62);
}

.type-count {
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
}

.section-title {
  display: block;
  margin: 0 0 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #f8fafc;
  letter-spacing: 0;
}

.menu-list {
  overflow: hidden;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.045);
  border: 1rpx solid rgba(255,255,255,0.07);
}

.menu-item {
  min-height: 92rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid rgba(255,255,255,0.07);
}

.menu-item:first-child {
  border-top: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.menu-icon {
  font-size: 30rpx;
}

.menu-title {
  font-size: 28rpx;
  color: rgba(255,255,255,0.82);
}

.menu-arrow {
  color: rgba(255,255,255,0.28);
  font-size: 42rpx;
}

.share-btn {
  margin-top: 30rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: rgba(59,130,246,0.18);
  color: #bfdbfe;
  font-size: 28rpx;
  border: 1rpx solid rgba(59,130,246,0.28);
}

.share-btn::after {
  border: none;
}

.version-info {
  padding: 32rpx 0 20rpx;
  text-align: center;
  color: rgba(255,255,255,0.26);
  font-size: 22rpx;
}

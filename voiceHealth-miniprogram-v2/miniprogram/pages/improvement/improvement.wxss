.container {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 28rpx;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 25rpx;
  line-height: 1.5;
  color: rgba(255,255,255,0.52);
}

.loading-wrap,
.empty-state {
  min-height: 560rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: rgba(255,255,255,0.58);
}

.loading-spinner {
  width: 46rpx;
  height: 46rpx;
  border: 4rpx solid rgba(255,255,255,0.12);
  border-top-color: #3b82f6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.empty-icon {
  font-size: 68rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
}

.empty-desc {
  max-width: 560rpx;
  text-align: center;
  font-size: 25rpx;
  line-height: 1.55;
  color: rgba(255,255,255,0.5);
}

.status-card,
.loop-card,
.section {
  background: rgba(255,255,255,0.045);
  border: 1rpx solid rgba(255,255,255,0.07);
  border-radius: 22rpx;
  padding: 26rpx;
  margin-bottom: 22rpx;
}

.status-card {
  background: linear-gradient(135deg, rgba(59,130,246,0.18), rgba(34,197,94,0.08));
}

.status-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.status-label {
  display: block;
  font-size: 31rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 8rpx;
}

.status-msg {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255,255,255,0.62);
}

.status-pill {
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(59,130,246,0.16);
  color: #bfdbfe;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  flex-shrink: 0;
}

.status-pill.completed {
  background: rgba(34,197,94,0.16);
  color: #86efac;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.metric {
  min-height: 94rpx;
  border-radius: 15rpx;
  background: rgba(255,255,255,0.055);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.metric-value {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #fff;
}

.metric-label {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: rgba(255,255,255,0.42);
}

.progress-track {
  height: 12rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255,255,255,0.12);
  margin: 22rpx 0 14rpx;
}

.progress-fill {
  height: 100%;
  background: #3b82f6;
  border-radius: 999rpx;
}

.date-line {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.48);
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 18rpx;
}

.loop-steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.loop-step {
  min-height: 76rpx;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.045);
  border: 1rpx solid rgba(255,255,255,0.07);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.loop-step.done {
  background: rgba(34,197,94,0.11);
  border-color: rgba(34,197,94,0.25);
}

.loop-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #86efac;
  font-size: 18rpx;
}

.loop-name {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

.action-card {
  display: flex;
  gap: 16rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(255,255,255,0.07);
}

.action-card:first-child {
  border-top: 0;
  padding-top: 0;
}

.action-card.checked .action-title {
  color: #93c5fd;
}

.action-check {
  margin-top: 6rpx;
  flex-shrink: 0;
}

.action-body {
  flex: 1;
  min-width: 0;
}

.action-head {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.action-category {
  font-size: 22rpx;
  color: rgba(147,197,253,0.75);
}

.action-priority {
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 36rpx;
}

.action-priority.high {
  color: #fecaca;
  background: rgba(239,68,68,0.12);
}

.action-priority.medium {
  color: #fde68a;
  background: rgba(245,158,11,0.12);
}

.action-priority.low {
  color: #86efac;
  background: rgba(34,197,94,0.12);
}

.action-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #fff;
  margin-bottom: 8rpx;
}

.action-why,
.action-target {
  display: block;
  font-size: 23rpx;
  line-height: 1.55;
  color: rgba(255,255,255,0.52);
}

.step-line {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
}

.step-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #60a5fa;
  margin-top: 13rpx;
  flex-shrink: 0;
}

.step-text {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  line-height: 1.55;
  color: rgba(255,255,255,0.64);
}

.action-target {
  margin-top: 10rpx;
  color: rgba(134,239,172,0.72);
}

.slider-row {
  margin-bottom: 24rpx;
}

.slider-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
  font-size: 25rpx;
  color: rgba(255,255,255,0.72);
}

.note-input {
  width: 100%;
  min-height: 150rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.08);
  color: #fff;
  font-size: 25rpx;
  line-height: 1.5;
  padding: 18rpx;
}

.placeholder {
  color: rgba(255,255,255,0.3);
}

.submit-btn,
.complete-btn,
.new-btn {
  width: 100%;
  height: 90rpx;
  border-radius: 18rpx;
  border: none;
  font-size: 29rpx;
  font-weight: 800;
  margin-top: 20rpx;
}

.submit-btn {
  background: #3b82f6;
  color: #fff;
}

.complete-btn {
  background: rgba(34,197,94,0.16);
  color: #86efac;
  border: 1rpx solid rgba(34,197,94,0.3);
}

.new-btn {
  background: #3b82f6;
  color: #fff;
}

.review-item {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 0;
}

.review-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #f59e0b;
  margin-top: 13rpx;
  flex-shrink: 0;
}

.review-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(255,255,255,0.62);
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.quick-btn {
  height: 72rpx;
  border-radius: 15rpx;
  background: rgba(255,255,255,0.06);
  color: rgba(255,255,255,0.74);
  border: 1rpx solid rgba(255,255,255,0.08);
  font-size: 23rpx;
}

.btn {
  width: 420rpx;
}

.disclaimer {
  text-align: center;
  font-size: 22rpx;
  line-height: 1.55;
  color: rgba(255,255,255,0.32);
  padding: 26rpx 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

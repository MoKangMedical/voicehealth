.container{padding:32rpx;min-height:100vh}
.header{text-align:center;margin-bottom:40rpx}
.title{font-size:40rpx;font-weight:700;display:block;margin-bottom:8rpx}
.update-date{font-size:24rpx;color:rgba(255,255,255,0.45)}
.section{margin-bottom:32rpx}
.section-title{font-size:28rpx;font-weight:600;display:block;margin-bottom:16rpx;color:#3b82f6}
.section-content{font-size:26rpx;color:rgba(255,255,255,0.65);line-height:1.6;display:block;margin-bottom:12rpx}
.list-item{display:flex;align-items:flex-start;gap:12rpx;margin-bottom:8rpx}
.dot{color:#3b82f6;flex-shrink:0}
.list-item text:last-child{font-size:26rpx;color:rgba(255,255,255,0.65)}

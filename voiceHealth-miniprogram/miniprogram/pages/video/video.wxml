<view class="container"><view wx:if="{{!videoPath&&!showResult}}"><camera class="camera" device-position="{{cameraMode}}" style="width:100%;height:500rpx;position:relative"><view wx:if="{{isRecording}}" style="position:absolute;top:20rpx;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:12rpx;padding:12rpx 24rpx;background:rgba(239,68,68,0.8);border-radius:30rpx"><view style="width:16rpx;height:16rpx;border-radius:50%;background:#fff"></view><text style="font-size:28rpx;color:#fff">{{formatTime(recordingTime)}}</text></view></camera><view style="display:flex;justify-content:space-around;align-items:center;padding:30rpx;background:rgba(255,255,255,0.05)"><view bindtap="switchCamera">🔄</view><view bindtap="{{isRecording?'stopRecording':'startRecording'}}" style="width:100rpx;height:100rpx;border-radius:50%;background:{{isRecording?'#ef4444':'rgba(255,255,255,0.2)'}};border:4rpx solid #fff;display:flex;align-items:center;justify-content:center"></view><view></view></view><view style="padding:24rpx 32rpx"><text style="font-size:26rpx;font-weight:600;color:rgba(255,255,255,0.45);display:block;margin-bottom:16rpx">检测项目</text><view style="display:flex;gap:16rpx"><view wx:for="{{detectItems}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleItem" style="flex:1;display:flex;flex-direction:column;align-items:center;padding:16rpx;background:{{item.enabled?'rgba(59,130,246,0.1)':'rgba(255,255,255,0.04)'}};border-radius:16rpx"><text style="font-size:32rpx;margin-bottom:8rpx">{{item.icon}}</text><text style="font-size:22rpx">{{item.name}}</text></view></view></view></view><view wx:if="{{videoPath&&!showResult&&!isAnalyzing}}" style="padding:32rpx"><video src="{{videoPath}}" controls style="width:100%;height:400rpx;border-radius:16rpx"/><view style="display:flex;gap:20rpx;margin-top:30rpx"><button class="btn btn-ghost" style="flex:1" bindtap="retake">重录</button><button class="btn btn-primary" style="flex:1" bindtap="startAnalysis">开始分析</button></view></view><view wx:if="{{isAnalyzing}}" style="padding:100rpx 32rpx;text-align:center"><text style="font-size:80rpx;display:block;margin-bottom:24rpx">🔬</text><text style="font-size:36rpx;font-weight:600;display:block">视频分析中...</text></view><view wx:if="{{showResult&&result}}" style="padding:32rpx"><view style="display:flex;align-items:center;justify-content:space-around;background:rgba(255,255,255,0.04);border-radius:24rpx;padding:40rpx;margin-bottom:30rpx"><view style="width:160rpx;height:160rpx;border-radius:50%;border:8rpx solid {{getScoreColor(result.overall_score)}};display:flex;flex-direction:column;align-items:center;justify-content:center"><text style="font-size:48rpx;font-weight:700">{{result.overall_score}}</text><text style="font-size:22rpx;color:rgba(255,255,255,0.45)">综合评分</text></view><view style="text-align:center"><text style="font-size:24rpx;color:rgba(255,255,255,0.45);display:block">预测年龄</text><text style="font-size:40rpx;font-weight:600">{{result.biological_age}}岁</text></view></view><view wx:if="{{result.skin}}" style="background:rgba(255,255,255,0.04);border-radius:16rpx;padding:24rpx;margin-bottom:16rpx;display:flex;align-items:center;gap:16rpx"><text>🧴</text><text style="flex:1;font-weight:600">皮肤</text><text style="color:{{getScoreColor(result.skin.overall_score)}};font-weight:700">{{result.skin.overall_score}}分</text></view><view wx:if="{{result.eye}}" style="background:rgba(255,255,255,0.04);border-radius:16rpx;padding:24rpx;margin-bottom:16rpx;display:flex;align-items:center;gap:16rpx"><text>👁️</text><text style="flex:1;font-weight:600">眼睛</text><text style="color:{{getScoreColor(result.eye.overall_score)}};font-weight:700">{{result.eye.overall_score}}分</text></view><view wx:if="{{result.hair}}" style="background:rgba(255,255,255,0.04);border-radius:16rpx;padding:24rpx;margin-bottom:16rpx;display:flex;align-items:center;gap:16rpx"><text>💇</text><text style="flex:1;font-weight:600">头发</text><text style="color:{{getScoreColor(result.hair.overall_score)}};font-weight:700">{{result.hair.overall_score}}分</text></view><view style="display:flex;gap:20rpx;margin-top:30rpx"><button class="btn btn-ghost" style="flex:1" bindtap="retake">重新检测</button><button class="btn btn-primary" style="flex:1" open-type="share">分享结果</button></view></view><disclaimer compact="{{true}}"/></view>
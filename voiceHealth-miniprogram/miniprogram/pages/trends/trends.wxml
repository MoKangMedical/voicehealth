<view class="container">
  <view class="header">
    <text class="title">健康趋势</text>
    <text class="subtitle">追踪你的健康变化</text>
  </view>
  
  <view class="range-selector">
    <view class="range-btn {{activeRange === item ? 'active' : ''}}" 
          wx:for="{{ranges}}" wx:key="*this"
          data-range="{{item}}" bindtap="switchRange">
      {{rangeLabels[index]}}
    </view>
  </view>
  
  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-value" style="color:{{getScoreColor(stats.avgScore)}}">{{stats.avgScore}}</text>
      <text class="stat-label">平均分</text>
    </view>
    <view class="stat-card">
      <text class="stat-value" style="color:#22c55e">{{stats.maxScore}}</text>
      <text class="stat-label">最高分</text>
    </view>
    <view class="stat-card">
      <text class="stat-value" style="color:#eab308">{{stats.minScore}}</text>
      <text class="stat-label">最低分</text>
    </view>
    <view class="stat-card">
      <text class="stat-value" style="color:{{stats.trend > 0 ? '#22c55e' : stats.trend < 0 ? '#ef4444' : '#888'}}">{{stats.trend > 0 ? '+' : ''}}{{stats.trend}}</text>
      <text class="stat-label">趋势</text>
    </view>
  </view>
  
  <view class="chart-card">
    <text class="chart-title">评分走势</text>
    <view class="chart">
      <view class="chart-bar" wx:for="{{chartData}}" wx:key="date">
        <view class="bar-fill" style="height:{{item.score}}%;background:{{getScoreColor(item.score)}}"></view>
        <text class="bar-label" wx:if="{{index % 5 === 0}}">{{item.date}}</text>
      </view>
    </view>
    <view class="chart-legend">
      <view class="legend-item"><view class="legend-dot" style="background:#22c55e"></view><text>80+</text></view>
      <view class="legend-item"><view class="legend-dot" style="background:#3b82f6"></view><text>60-80</text></view>
      <view class="legend-item"><view class="legend-dot" style="background:#eab308"></view><text>&lt;60</text></view>
    </view>
  </view>
  
  <view class="insights-card">
    <text class="insights-title">AI洞察</text>
    <view class="insight-item" wx:for="{{insights}}" wx:key="index">
      <text class="insight-text">{{item}}</text>
    </view>
  </view>
  
  <view class="disclaimer">
    <text>* 趋势数据仅供参考，不构成医学建议</text>
  </view>
</view>

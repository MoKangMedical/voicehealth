.container{min-height:100vh;padding:32rpx}
.header{text-align:center;margin-bottom:40rpx}
.title{font-size:40rpx;font-weight:700;display:block}
.subtitle{font-size:26rpx;color:rgba(255,255,255,0.45)}
.streak-card{background:linear-gradient(135deg,rgba(59,130,246,0.15),rgba(34,197,94,0.1));border-radius:24rpx;padding:40rpx;text-align:center;margin-bottom:24rpx}
.streak-num{font-size:96rpx;font-weight:700;color:#3b82f6}
.streak-label{font-size:28rpx;color:rgba(255,255,255,0.65);display:block;margin-bottom:24rpx}
.streak-stats{display:flex;justify-content:center;gap:40rpx}
.stat{text-align:center}
.stat-value{font-size:32rpx;font-weight:600;display:block}
.stat-label{font-size:22rpx;color:rgba(255,255,255,0.45)}
.stat-divider{width:1rpx;background:rgba(255,255,255,0.1)}
.week-card{background:rgba(255,255,255,0.04);border-radius:20rpx;padding:24rpx;margin-bottom:24rpx}
.week-title{font-size:26rpx;font-weight:600;display:block;margin-bottom:16rpx}
.week-days{display:flex;justify-content:space-around}
.week-day{display:flex;flex-direction:column;align-items:center;gap:8rpx;padding:12rpx}
.week-day.checked{background:rgba(34,197,94,0.1);border-radius:12rpx}
.week-day.today{border:2rpx solid #3b82f6;border-radius:12rpx}
.day-label{font-size:22rpx;color:rgba(255,255,255,0.45)}
.day-num{font-size:28rpx;font-weight:600}
.day-check{font-size:24rpx;color:#22c55e}
.checkin-btn{width:100%;height:100rpx;border-radius:50rpx;font-size:32rpx;font-weight:600;background:#3b82f6;color:#fff;border:none;margin-bottom:24rpx}
.checkin-btn.checked{background:rgba(34,197,94,0.2);color:#22c55e}
.rewards-card{background:rgba(255,255,255,0.04);border-radius:20rpx;padding:24rpx;margin-bottom:24rpx}
.rewards-title{font-size:26rpx;font-weight:600;display:block;margin-bottom:16rpx}
.reward-item{display:flex;align-items:center;gap:16rpx;padding:16rpx 0;border-bottom:1rpx solid rgba(255,255,255,0.06)}
.reward-item:last-child{border-bottom:none}
.reward-item.unlocked{opacity:1}
.reward-icon{font-size:36rpx}
.reward-info{flex:1}
.reward-name{font-size:26rpx;font-weight:500;display:block}
.reward-req{font-size:22rpx;color:rgba(255,255,255,0.45)}
.reward-status{font-size:28rpx}
.disclaimer{text-align:center;font-size:22rpx;color:rgba(255,255,255,0.25);padding:20rpx}

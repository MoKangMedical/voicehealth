/* VoiceHealth - Index Page Styles */
/* Dark theme: #0a0a0f | Primary: #3b82f6 | Green: #22c55e */
/* Glassmorphism + rounded design */

.container {
  padding-bottom: 60rpx;
}

/* ========== Header ========== */
.header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0 32rpx;
}

.logo {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.logo-icon {
  font-size: 48rpx;
}

.logo-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

/* ========== Main Card ========== */
.main-card {
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  margin-bottom: 12rpx;
}

.card-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.45);
  text-align: center;
  margin-bottom: 40rpx;
}

/* ========== Reading Section ========== */
.reading-section {
  margin-bottom: 40rpx;
}

.reading-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.reading-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.refresh-btn {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: rgba(59, 130, 246, 0.1);
  border-radius: 12rpx;
}

.refresh-text {
  font-size: 24rpx;
  color: #3b82f6;
}

.reading-text-box {
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  min-height: 120rpx;
}

.reading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.8;
}

/* ========== Record Area ========== */
.record-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 20rpx;
}

.record-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 8rpx 32rpx rgba(59, 130, 246, 0.3);
  transition: all 0.3s ease;
}

.record-btn::before,
.record-btn::after {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(59, 130, 246, 0.15);
  z-index: -1;
}

.record-btn.recording {
  background: linear-gradient(135deg, #ef4444, #dc2626);
  box-shadow: 0 8rpx 32rpx rgba(239, 68, 68, 0.4);
  animation: pulse 1.5s ease-in-out infinite;
}

.record-btn.recording::before {
  animation: ripple 2s linear infinite;
}

.record-btn.recording::after {
  animation: ripple 2s linear infinite 0.5s;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

@keyframes ripple {
  0% {
    transform: scale(1);
    opacity: 0.4;
  }
  100% {
    transform: scale(1.8);
    opacity: 0;
  }
}

.record-btn-inner {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.record-icon {
  font-size: 52rpx;
}

.record-time {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  margin-top: 24rpx;
  font-variant-numeric: tabular-nums;
}

.record-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 8rpx;
}

/* ========== Analyze Button ========== */
.btn-analyze {
  margin-top: 32rpx;
  width: 100%;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  border-radius: 20rpx;
  height: 96rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.2);
}

.btn-analyze[disabled] {
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.25);
  box-shadow: none;
}

/* ========== Free Info ========== */
.free-info {
  text-align: center;
  margin-top: 20rpx;
  font-size: 24rpx;
}

/* ========== Features Grid ========== */
.features-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.feature-item {
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: all 0.2s ease;
}

.feature-item:active {
  background: rgba(255, 255, 255, 0.08);
  transform: scale(0.97);
}

.feature-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.feature-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.feature-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  text-align: center;
}

/* ========== Tips Card ========== */
.tips-card {
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 12rpx 0;
}

.tip-item:not(:last-child) {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.tip-dot {
  color: #3b82f6;
  font-size: 28rpx;
  flex-shrink: 0;
  line-height: 1.6;
}

.tip-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.6;
}

/* Quick Actions */
.quick-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 16rpx;
}
.quick-icon {
  font-size: 36rpx;
}
.quick-name {
  font-size: 22rpx;
  color: rgba(255,255,255,0.65);
}

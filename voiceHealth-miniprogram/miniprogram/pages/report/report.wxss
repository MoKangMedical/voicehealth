/* pages/report/report.wxss */
.container { padding: 32rpx; min-height: 100vh; }

/* 加载 */
.loading-wrap { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 60vh; }
.loading-spinner { width: 64rpx; height: 64rpx; border: 4rpx solid rgba(59,130,246,0.2); border-top-color: #3b82f6; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: rgba(255,255,255,0.45); margin-top: 20rpx; }

/* 错误状态 */
.error-wrap { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 60vh; padding: 0 40rpx; }
.error-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.error-title { font-size: 36rpx; font-weight: 700; margin-bottom: 12rpx; }
.error-msg { font-size: 26rpx; color: rgba(255,255,255,0.45); text-align: center; margin-bottom: 40rpx; }
.error-actions { display: flex; gap: 20rpx; }
.btn-retry { display: flex; align-items: center; justify-content: center; height: 80rpx; padding: 0 40rpx; background: #3b82f6; color: #fff; border-radius: 16rpx; font-size: 28rpx; font-weight: 600; border: none; }
.btn-home { display: flex; align-items: center; justify-content: center; height: 80rpx; padding: 0 40rpx; background: rgba(255,255,255,0.06); color: #e2e2e8; border-radius: 16rpx; font-size: 28rpx; border: 1rpx solid rgba(255,255,255,0.08); }

/* 分析类型标识 */
.analysis-type-badge { display: inline-flex; align-items: center; gap: 8rpx; padding: 8rpx 20rpx; background: rgba(59,130,246,0.12); border-radius: 20rpx; margin-bottom: 24rpx; }
.type-icon { font-size: 28rpx; }
.type-text { font-size: 24rpx; color: #3b82f6; font-weight: 500; }

/* 评分卡片 */
.score-card { background: rgba(255,255,255,0.04); border-radius: 24rpx; padding: 48rpx 32rpx; text-align: center; margin-bottom: 32rpx; }
.score-ring { position: relative; width: 240rpx; height: 240rpx; margin: 0 auto 24rpx; }
.score-ring-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border-radius: 50%; border: 8rpx solid rgba(255,255,255,0.06); }
.score-inner { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; }
.score-number { font-size: 72rpx; font-weight: 800; display: block; line-height: 1; }
.score-label { font-size: 24rpx; color: rgba(255,255,255,0.45); display: block; margin-top: 8rpx; }
.score-meta { text-align: center; }
.score-level { font-size: 32rpx; font-weight: 700; display: block; margin-bottom: 8rpx; }
.score-date { font-size: 24rpx; color: rgba(255,255,255,0.35); }
.score-desc { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(255,255,255,0.06); }
.score-desc text { font-size: 26rpx; color: rgba(255,255,255,0.55); line-height: 1.6; }

/* 通用section */
.section { margin-bottom: 32rpx; }
.section-title { font-size: 30rpx; font-weight: 600; display: block; margin-bottom: 20rpx; }

/* 声学特征 */
.feature-list { display: flex; flex-direction: column; gap: 20rpx; }
.feature-item { background: rgba(255,255,255,0.04); border-radius: 20rpx; padding: 28rpx; }
.feature-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.feature-left { display: flex; align-items: center; gap: 12rpx; }
.feature-icon { font-size: 32rpx; }
.feature-name { font-size: 28rpx; font-weight: 600; }
.feature-score { font-size: 36rpx; font-weight: 800; }
.feature-bar-bg { height: 8rpx; background: rgba(255,255,255,0.06); border-radius: 4rpx; margin-bottom: 12rpx; overflow: hidden; }
.feature-bar { height: 100%; border-radius: 4rpx; transition: width 0.6s ease; }
.feature-desc { font-size: 24rpx; color: rgba(255,255,255,0.55); }

/* 年龄卡片 */
.age-card { background: rgba(255,255,255,0.04); border-radius: 20rpx; padding: 40rpx; text-align: center; }
.age-main { display: flex; align-items: baseline; justify-content: center; gap: 4rpx; margin-bottom: 12rpx; }
.age-value { font-size: 64rpx; font-weight: 800; color: #3b82f6; }
.age-unit { font-size: 28rpx; color: rgba(255,255,255,0.45); }
.age-desc { font-size: 24rpx; color: rgba(255,255,255,0.45); }

/* 疾病风险 */
.risk-list { display: flex; flex-direction: column; gap: 20rpx; }
.risk-item { background: rgba(255,255,255,0.04); border-radius: 20rpx; padding: 28rpx; }
.risk-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.risk-category { font-size: 28rpx; font-weight: 600; }
.risk-badge { padding: 6rpx 16rpx; border-radius: 12rpx; font-size: 22rpx; font-weight: 600; }
.risk-badge.low { background: rgba(34,197,94,0.15); color: #22c55e; }
.risk-badge.medium { background: rgba(234,179,8,0.15); color: #eab308; }
.risk-badge.high { background: rgba(239,68,68,0.15); color: #ef4444; }
.risk-bar-bg { height: 8rpx; background: rgba(255,255,255,0.06); border-radius: 4rpx; margin-bottom: 12rpx; overflow: hidden; }
.risk-bar { height: 100%; border-radius: 4rpx; }
.risk-bar.low { background: #22c55e; }
.risk-bar.medium { background: #eab308; }
.risk-bar.high { background: #ef4444; }
.risk-desc { font-size: 24rpx; color: rgba(255,255,255,0.55); }

/* AI建议 */
.advice-list { display: flex; flex-direction: column; gap: 16rpx; }
.advice-item { background: rgba(255,255,255,0.04); border-radius: 20rpx; padding: 28rpx; display: flex; gap: 20rpx; align-items: flex-start; }
.advice-icon { font-size: 40rpx; flex-shrink: 0; }
.advice-content { flex: 1; }
.advice-title { font-size: 28rpx; font-weight: 600; display: block; margin-bottom: 8rpx; }
.advice-text { font-size: 24rpx; color: rgba(255,255,255,0.55); line-height: 1.6; }

/* 操作按钮 */
.action-bar { margin-top: 40rpx; padding-bottom: 20rpx; }
.btn-share { display: flex; align-items: center; justify-content: center; height: 96rpx; border-radius: 20rpx; font-size: 30rpx; font-weight: 600; background: #3b82f6; color: #fff; border: none; margin-bottom: 16rpx; }
.btn-history { display: flex; align-items: center; justify-content: center; height: 96rpx; border-radius: 20rpx; font-size: 30rpx; font-weight: 600; background: rgba(59,130,246,0.12); color: #3b82f6; border: 1rpx solid rgba(59,130,246,0.2); margin-bottom: 16rpx; }
.btn-back { display: flex; align-items: center; justify-content: center; height: 96rpx; border-radius: 20rpx; font-size: 30rpx; font-weight: 600; background: rgba(255,255,255,0.04); color: #e2e2e8; border: 1rpx solid rgba(255,255,255,0.06); }

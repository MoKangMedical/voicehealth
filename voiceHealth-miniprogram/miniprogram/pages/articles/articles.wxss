.container{min-height:100vh;padding:32rpx}
.header{text-align:center;margin-bottom:32rpx}
.title{font-size:40rpx;font-weight:700;display:block}
.subtitle{font-size:26rpx;color:rgba(255,255,255,0.45)}
.tabs{display:flex;gap:12rpx;margin-bottom:24rpx;white-space:nowrap}
.tab{padding:12rpx 24rpx;border-radius:20rpx;font-size:24rpx;background:rgba(255,255,255,0.04);display:inline-block}
.tab.active{background:#3b82f6;color:#fff}
.article-card{display:flex;gap:20rpx;background:rgba(255,255,255,0.04);border-radius:16rpx;padding:24rpx;margin-bottom:16rpx}
.article-icon{font-size:48rpx;width:80rpx;height:80rpx;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.04);border-radius:12rpx;flex-shrink:0}
.article-content{flex:1;min-width:0}
.article-title{font-size:28rpx;font-weight:600;display:block;margin-bottom:8rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.article-summary{font-size:24rpx;color:rgba(255,255,255,0.55);display:block;margin-bottom:12rpx;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.article-meta{display:flex;gap:16rpx}
.meta-category{font-size:20rpx;padding:4rpx 12rpx;background:rgba(59,130,246,0.15);color:#3b82f6;border-radius:8rpx}
.meta-date,.meta-views{font-size:20rpx;color:rgba(255,255,255,0.35)}
.disclaimer{text-align:center;font-size:22rpx;color:rgba(255,255,255,0.25);padding:30rpx}

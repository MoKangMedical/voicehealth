.container {
  min-height: 100vh;
  background: #0a0a0f;
  color: #e2e2e8;
  padding-bottom: 60rpx;
}

/* Section Header */
.section-header {
  padding: 32rpx 32rpx 16rpx;
  text-align: center;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}

.section-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
}

/* Camera Section */
.camera-section {
  padding-top: 20rpx;
}

.camera-wrapper {
  margin: 0 32rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
}

.camera {
  width: 100%;
  height: 600rpx;
  display: block;
}

.camera-overlay {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.face-guide {
  width: 400rpx;
  height: 500rpx;
  position: relative;
}

.guide-corner {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border-color: #3b82f6;
  border-style: solid;
  border-width: 0;
}

.guide-corner.top-left {
  top: 0;
  left: 0;
  border-top-width: 4rpx;
  border-left-width: 4rpx;
  border-top-left-radius: 12rpx;
}

.guide-corner.top-right {
  top: 0;
  right: 0;
  border-top-width: 4rpx;
  border-right-width: 4rpx;
  border-top-right-radius: 12rpx;
}

.guide-corner.bottom-left {
  bottom: 0;
  left: 0;
  border-bottom-width: 4rpx;
  border-left-width: 4rpx;
  border-bottom-left-radius: 12rpx;
}

.guide-corner.bottom-right {
  bottom: 0;
  right: 0;
  border-bottom-width: 4rpx;
  border-right-width: 4rpx;
  border-bottom-right-radius: 12rpx;
}

/* Camera Controls */
.camera-controls {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 40rpx 60rpx;
}

.control-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.control-icon {
  font-size: 40rpx;
}

.control-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.shutter-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
}

.shutter-inner {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ef4444;
}

/* Preview Section */
.preview-section {
  padding: 0 32rpx;
}

.preview-wrapper {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.preview-image {
  width: 100%;
  height: 600rpx;
  display: block;
}

.preview-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(34, 197, 94, 0.85);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.preview-actions {
  display: flex;
  gap: 24rpx;
}

.preview-actions .btn {
  flex: 1;
}

/* Buttons */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  line-height: 88rpx;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
}

.btn-primary[disabled] {
  background: rgba(59, 130, 246, 0.4);
  color: rgba(255, 255, 255, 0.5);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.06);
  color: #e2e2e8;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.btn-icon {
  font-size: 28rpx;
}

/* Result Section */
.result-section {
  padding: 0 32rpx;
}

/* Score Card */
.score-card {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.score-ring {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-number {
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1;
}

.score-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 8rpx;
}

.score-divider {
  width: 2rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.1);
}

.age-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.age-number {
  font-size: 56rpx;
  font-weight: 700;
  color: #3b82f6;
  line-height: 1;
}

.age-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 8rpx;
}

/* Dimensions Card */
.dimensions-card {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.dimension-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.dimension-item:last-child {
  border-bottom: none;
}

.dim-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 0 0 160rpx;
}

.dim-icon {
  font-size: 28rpx;
}

.dim-name {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
}

.dim-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.dim-bar-bg {
  flex: 1;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 6rpx;
  overflow: hidden;
}

.dim-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.6s ease;
}

.dim-score {
  font-size: 28rpx;
  font-weight: 700;
  flex: 0 0 60rpx;
  text-align: right;
}

/* Summary Card */
.summary-card {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.summary-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.8;
}

/* Suggestions Card */
.suggestions-card {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.suggestion-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
}

.suggestion-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #3b82f6;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.suggestion-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.7;
}

/* Result Actions */
.result-actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.result-actions .btn {
  flex: 1;
}

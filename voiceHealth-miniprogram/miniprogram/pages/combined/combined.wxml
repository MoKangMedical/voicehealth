<view class="container"><view style="text-align:center;margin-bottom:40rpx"><text style="font-size:40rpx;font-weight:700;display:block">综合健康评估</text><text style="font-size:26rpx;color:rgba(255,255,255,0.45)">声纹+面部双维度深度分析</text></view><view wx:if="{{!showResult}}" style="text-align:center;padding:60rpx 0"><button class="btn btn-primary" style="height:112rpx;font-size:32rpx" bindtap="startCombinedAnalysis" loading="{{isAnalyzing}}">{{isAnalyzing?'分析中...':'开始综合评估'}}</button></view><view wx:if="{{showResult&&combinedResult}}"><view style="display:flex;justify-content:center;gap:60rpx;margin-bottom:40rpx"><view style="width:180rpx;height:180rpx;border-radius:50%;border:8rpx solid {{getScoreColor(combinedResult.overall_score)}};display:flex;flex-direction:column;align-items:center;justify-content:center"><text style="font-size:48rpx;font-weight:700">{{combinedResult.overall_score}}</text><text style="font-size:22rpx;color:rgba(255,255,255,0.45)">综合评分</text></view><view style="width:180rpx;height:180rpx;border-radius:50%;border:8rpx solid #3b82f6;display:flex;flex-direction:column;align-items:center;justify-content:center"><text style="font-size:48rpx;font-weight:700">{{combinedResult.biological_age}}</text><text style="font-size:22rpx;color:rgba(255,255,255,0.45)">生物学年龄</text></view></view><view style="background:rgba(255,255,255,0.04);border-radius:20rpx;padding:24rpx;margin-bottom:24rpx"><text style="font-size:28rpx;font-weight:600;display:block;margin-bottom:20rpx">六维健康指标</text><view style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:20rpx"><view wx:for="{{combinedResult.dimensions}}" wx:key="name" style="text-align:center"><text style="font-size:36rpx;display:block">{{item.icon}}</text><text style="font-size:22rpx;color:rgba(255,255,255,0.65);display:block">{{item.name}}</text><text style="font-size:32rpx;font-weight:700;color:{{getScoreColor(item.score)}}">{{item.score}}</text></view></view></view><view style="background:rgba(255,255,255,0.04);border-radius:20rpx;padding:24rpx;margin-bottom:24rpx"><text style="font-size:28rpx;font-weight:600;display:block;margin-bottom:12rpx">健康建议</text><view wx:for="{{combinedResult.suggestions}}" wx:key="index" style="display:flex;align-items:flex-start;gap:16rpx;margin-bottom:12rpx"><view style="width:40rpx;height:40rpx;border-radius:50%;background:#3b82f6;display:flex;align-items:center;justify-content:center;font-size:22rpx;font-weight:700;flex-shrink:0">{{index+1}}</view><text style="font-size:26rpx;color:rgba(255,255,255,0.65)">{{item}}</text></view></view><view style="display:flex;gap:20rpx;margin-top:40rpx"><button class="btn btn-ghost" style="flex:1" bindtap="goHome">返回首页</button><button class="btn btn-primary" style="flex:1" open-type="share">分享报告</button></view></view><disclaimer compact="{{true}}"/></view>
<!--pages/science/science.wxml-->
<view class="container">
  <view class="header">
    <text class="title">科学依据</text>
    <text class="subtitle">基于循证医学的健康检测系统</text>
  </view>

  <!-- Tabs -->
  <scroll-view class="tabs" scroll-x>
    <view class="tab {{activeTab === index ? 'active' : ''}}" 
          wx:for="{{tabs}}" wx:key="index"
          data-index="{{index}}" bindtap="switchTab">
      {{item}}
    </view>
  </scroll-view>

  <!-- 理论基础 -->
  <view class="content" wx:if="{{activeTab === 0}}">
    <view class="theory-card" wx:for="{{theories}}" wx:key="title">
      <view class="theory-header">
        <text class="theory-icon">{{item.icon}}</text>
        <text class="theory-title">{{item.title}}</text>
      </view>
      <text class="theory-desc">{{item.description}}</text>
      <view class="mechanisms">
        <view class="mechanism" wx:for="{{item.mechanisms}}" wx:for-item="mech" wx:key="name"
              data-title="{{mech.name}}" data-detail="{{mech.detail}}" bindtap="showDetail">
          <text class="mech-name">{{mech.name}}</text>
          <text class="mech-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 学术文献 -->
  <view class="content" wx:if="{{activeTab === 1}}">
    <view class="paper-card" wx:for="{{papers}}" wx:key="title">
      <view class="paper-header">
        <text class="paper-category">{{item.category}}</text>
        <text class="paper-year">{{item.year}}</text>
      </view>
      <text class="paper-title">{{item.title}}</text>
      <text class="paper-authors">{{item.authors}}</text>
      <text class="paper-journal">{{item.journal}}</text>
      <text class="paper-finding">{{item.finding}}</text>
      <view class="paper-doi" data-doi="{{item.doi}}" bindtap="copyDoi">
        <text class="doi-text">DOI: {{item.doi}}</text>
        <text class="doi-copy">复制</text>
      </view>
    </view>
  </view>

  <!-- 技术原理 -->
  <view class="content" wx:if="{{activeTab === 2}}">
    <view class="tech-flow">
      <view class="tech-step" wx:for="{{techFlow}}" wx:key="step">
        <view class="step-number">{{item.step}}</view>
        <view class="step-line"></view>
        <view class="step-content">
          <text class="step-title">{{item.title}}</text>
          <text class="step-desc">{{item.desc}}</text>
          <text class="step-detail">{{item.detail}}</text>
        </view>
      </view>
    </view>
    
    <view class="feature-table">
      <text class="table-title">59维声学特征分类</text>
      <view class="table-row header">
        <text class="col-name">特征类型</text>
        <text class="col-dim">维度</text>
        <text class="col-relevance">临床相关性</text>
      </view>
      <view class="table-row">
        <text class="col-name">MFCC</text>
        <text class="col-dim">26</text>
        <text class="col-relevance">声道形状、共鸣特性</text>
      </view>
      <view class="table-row">
        <text class="col-name">基频F0</text>
        <text class="col-dim">6</text>
        <text class="col-relevance">声带张力、激素水平</text>
      </view>
      <view class="table-row">
        <text class="col-name">Jitter/Shimmer</text>
        <text class="col-dim">6</text>
        <text class="col-relevance">声带振动稳定性</text>
      </view>
      <view class="table-row">
        <text class="col-name">HNR</text>
        <text class="col-dim">2</text>
        <text class="col-relevance">声音清晰度</text>
      </view>
      <view class="table-row">
        <text class="col-name">频谱特征</text>
        <text class="col-dim">6</text>
        <text class="col-relevance">频谱分布特性</text>
      </view>
      <view class="table-row">
        <text class="col-name">韵律特征</text>
        <text class="col-dim">9</text>
        <text class="col-relevance">语速、停顿、节奏</text>
      </view>
      <view class="table-row">
        <text class="col-name">共振峰</text>
        <text class="col-dim">4</text>
        <text class="col-relevance">声道共振频率</text>
      </view>
      <view class="table-row">
        <text class="col-name">能量特征</text>
        <text class="col-dim">2</text>
        <text class="col-relevance">语音强度</text>
      </view>
    </view>
  </view>

  <!-- 临床验证 -->
  <view class="content" wx:if="{{activeTab === 3}}">
    <view class="validation-card">
      <view class="metric">
        <text class="metric-value">{{validation.accuracy}}</text>
        <text class="metric-label">准确率</text>
      </view>
      <view class="metric">
        <text class="metric-value">{{validation.sensitivity}}</text>
        <text class="metric-label">灵敏度</text>
      </view>
      <view class="metric">
        <text class="metric-value">{{validation.specificity}}</text>
        <text class="metric-label">特异度</text>
      </view>
      <view class="metric">
        <text class="metric-value">{{validation.auc}}</text>
        <text class="metric-label">AUC</text>
      </view>
    </view>
    
    <view class="stats-card">
      <view class="stat">
        <text class="stat-value">{{validation.samples}}</text>
        <text class="stat-label">训练样本</text>
      </view>
      <view class="stat">
        <text class="stat-value">{{validation.diseases}}</text>
        <text class="stat-label">检测疾病</text>
      </view>
    </view>
    
    <view class="studies-card">
      <text class="card-title">疾病检测准确率</text>
      <view class="study" wx:for="{{validation.studies}}" wx:key="name">
        <view class="study-header">
          <text class="study-name">{{item.name}}</text>
          <text class="study-accuracy">{{item.accuracy}}</text>
        </view>
        <text class="study-reference">{{item.reference}}</text>
      </view>
    </view>
    
    <view class="diseases-card">
      <text class="card-title">疾病关联机制</text>
      <view class="disease" wx:for="{{diseases}}" wx:key="name">
        <text class="disease-name">{{item.name}}</text>
        <text class="disease-mechanism">{{item.mechanism}}</text>
        <view class="disease-features">
          <text class="feature-tag" wx:for="{{item.features}}" wx:for-item="feat" wx:key="*this">{{feat}}</text>
        </view>
        <text class="disease-accuracy">准确率: {{item.accuracy}}</text>
      </view>
    </view>
  </view>

  <!-- 局限性 -->
  <view class="content" wx:if="{{activeTab === 4}}">
    <view class="limitation-section">
      <text class="section-title">🎤 声纹检测局限</text>
      <view class="limitation-list">
        <view class="limitation" wx:for="{{limitations.voice}}" wx:key="*this">
          <text class="limitation-dot">•</text>
          <text class="limitation-text">{{item}}</text>
        </view>
      </view>
    </view>
    
    <view class="limitation-section">
      <text class="section-title">📸 面部检测局限</text>
      <view class="limitation-list">
        <view class="limitation" wx:for="{{limitations.face}}" wx:key="*this">
          <text class="limitation-dot">•</text>
          <text class="limitation-text">{{item}}</text>
        </view>
      </view>
    </view>
    
    <view class="limitation-section">
      <text class="section-title">🎬 视频检测局限</text>
      <view class="limitation-list">
        <view class="limitation" wx:for="{{limitations.video}}" wx:key="*this">
          <text class="limitation-dot">•</text>
          <text class="limitation-text">{{item}}</text>
        </view>
      </view>
    </view>
    
    <view class="limitation-section">
      <text class="section-title">⚠️ 总体局限</text>
      <view class="limitation-list">
        <view class="limitation" wx:for="{{limitations.general}}" wx:key="*this">
          <text class="limitation-dot">•</text>
          <text class="limitation-text">{{item}}</text>
        </view>
      </view>
    </view>
    
    <view class="disclaimer-card">
      <text class="disclaimer-title">免责声明</text>
      <text class="disclaimer-text">{{disclaimer}}</text>
    </view>
  </view>
</view>

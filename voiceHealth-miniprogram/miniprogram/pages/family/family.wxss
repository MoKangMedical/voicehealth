.container{min-height:100vh;padding:32rpx}
.header{text-align:center;margin-bottom:32rpx}
.title{font-size:40rpx;font-weight:700;display:block}
.subtitle{font-size:26rpx;color:rgba(255,255,255,0.45)}
.member-list{margin-bottom:24rpx}
.member-card{display:flex;align-items:center;gap:20rpx;background:rgba(255,255,255,0.04);border-radius:16rpx;padding:24rpx;margin-bottom:12rpx}
.member-card.main{border:1rpx solid rgba(59,130,246,0.3)}
.member-avatar{font-size:48rpx;width:80rpx;height:80rpx;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.06);border-radius:50%}
.member-info{flex:1}
.member-name{font-size:28rpx;font-weight:600;display:block}
.member-relation{font-size:22rpx;color:rgba(255,255,255,0.45)}
.member-actions{}
.remove-btn{width:48rpx;height:48rpx;display:flex;align-items:center;justify-content:center;background:rgba(239,68,68,0.2);border-radius:50%;font-size:24rpx;color:#ef4444}
.add-section{margin-bottom:24rpx}
.add-btn{width:100%;height:88rpx;border-radius:16rpx;background:rgba(59,130,246,0.15);color:#3b82f6;font-size:28rpx;border:1rpx dashed rgba(59,130,246,0.3)}
.add-form{margin-bottom:24rpx}
.form-card{background:rgba(255,255,255,0.04);border-radius:16rpx;padding:24rpx}
.form-title{font-size:28rpx;font-weight:600;display:block;margin-bottom:20rpx}
.form-input{width:100%;height:80rpx;background:rgba(255,255,255,0.06);border-radius:12rpx;padding:0 20rpx;margin-bottom:16rpx;font-size:28rpx;color:#e2e2e8}
.form-picker{margin-bottom:16rpx}
.picker-value{height:80rpx;line-height:80rpx;background:rgba(255,255,255,0.06);border-radius:12rpx;padding:0 20rpx;font-size:28rpx;color:rgba(255,255,255,0.65)}
.form-actions{display:flex;gap:16rpx}
.btn-cancel{flex:1;height:80rpx;border-radius:12rpx;background:rgba(255,255,255,0.06);color:rgba(255,255,255,0.65);font-size:28rpx;border:none}
.btn-confirm{flex:1;height:80rpx;border-radius:12rpx;background:#3b82f6;color:#fff;font-size:28rpx;border:none}
.tips{background:rgba(255,255,255,0.04);border-radius:16rpx;padding:24rpx}
.tips-title{font-size:26rpx;font-weight:600;display:block;margin-bottom:16rpx}
.tip-item{display:flex;gap:12rpx;margin-bottom:8rpx}
.tip-dot{color:#3b82f6}
.tip-text{font-size:24rpx;color:rgba(255,255,255,0.65)}

/* pages/history/history.wxss */
.container { padding: 32rpx; min-height: 100vh; }

/* 页头 */
.page-header { margin-bottom: 24rpx; }
.page-title { font-size: 40rpx; font-weight: 700; display: block; margin-bottom: 8rpx; }
.page-subtitle { font-size: 26rpx; color: rgba(255,255,255,0.45); }

/* 筛选栏 */
.filter-bar { display: flex; gap: 12rpx; margin-bottom: 24rpx; overflow-x: auto; white-space: nowrap; }
.filter-item { display: inline-flex; align-items: center; padding: 12rpx 24rpx; background: rgba(255,255,255,0.04); border-radius: 24rpx; font-size: 24rpx; color: rgba(255,255,255,0.55); border: 1rpx solid rgba(255,255,255,0.06); }
.filter-item.active { background: rgba(59,130,246,0.15); color: #3b82f6; border-color: rgba(59,130,246,0.3); }

/* 加载 */
.loading-wrap { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 0; }
.loading-spinner { width: 64rpx; height: 64rpx; border: 4rpx solid rgba(59,130,246,0.2); border-top-color: #3b82f6; border-radius: 50%; animation: spin 0.8s linear infinite; }
.loading-spinner-small { width: 32rpx; height: 32rpx; border: 3rpx solid rgba(59,130,246,0.2); border-top-color: #3b82f6; border-radius: 50%; animation: spin 0.8s linear infinite; margin-right: 12rpx; }
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: rgba(255,255,255,0.45); margin-top: 20rpx; }

/* 错误状态 */
.error-wrap { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 0; }
.error-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.error-title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; color: rgba(255,255,255,0.55); }
.btn-retry { display: flex; align-items: center; justify-content: center; height: 80rpx; padding: 0 40rpx; background: #3b82f6; color: #fff; border-radius: 16rpx; font-size: 28rpx; font-weight: 600; border: none; }

/* 空状态 */
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 160rpx 0; }
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: rgba(255,255,255,0.45); margin-bottom: 40rpx; text-align: center; }
.empty-btn { display: inline-flex; align-items: center; justify-content: center; height: 80rpx; padding: 0 48rpx; background: #3b82f6; color: #fff; border-radius: 20rpx; font-size: 28rpx; font-weight: 600; text-decoration: none; }

/* 记录列表 */
.record-list { display: flex; flex-direction: column; gap: 20rpx; }
.record-item { background: rgba(255,255,255,0.04); border-radius: 20rpx; padding: 28rpx; display: flex; align-items: center; gap: 24rpx; }
.record-item:active { background: rgba(255,255,255,0.08); }
.record-score-ring { width: 100rpx; height: 100rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.08); display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; }
.record-score { font-size: 36rpx; font-weight: 800; line-height: 1; }
.record-score-unit { font-size: 20rpx; color: rgba(255,255,255,0.35); }
.record-info { flex: 1; }
.record-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.record-summary { font-size: 28rpx; font-weight: 500; flex: 1; }
.record-type-badge { display: inline-flex; align-items: center; gap: 4rpx; padding: 4rpx 12rpx; background: rgba(255,255,255,0.06); border-radius: 12rpx; flex-shrink: 0; }
.type-icon { font-size: 20rpx; }
.type-text { font-size: 20rpx; color: rgba(255,255,255,0.45); }
.record-date { font-size: 24rpx; color: rgba(255,255,255,0.35); }
.record-arrow { font-size: 32rpx; color: rgba(255,255,255,0.2); flex-shrink: 0; }

/* 加载更多 */
.load-more { display: flex; align-items: center; justify-content: center; padding: 32rpx 0; }
.load-more-text { font-size: 24rpx; color: rgba(255,255,255,0.25); }

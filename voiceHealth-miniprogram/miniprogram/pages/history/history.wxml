<!--pages/history/history.wxml-->
<view class="container">
  <view class="page-header">
    <text class="page-title">检测记录</text>
    <text class="page-subtitle">查看您的健康检测历史</text>
  </view>

  <!-- 筛选标签 -->
  <view class="filter-bar">
    <view class="filter-item {{filterType === 'all' ? 'active' : ''}}" data-type="all" bindtap="switchFilter">
      <text>全部</text>
    </view>
    <view class="filter-item {{filterType === 'voice' ? 'active' : ''}}" data-type="voice" bindtap="switchFilter">
      <text>🎤 语音</text>
    </view>
    <view class="filter-item {{filterType === 'face' ? 'active' : ''}}" data-type="face" bindtap="switchFilter">
      <text>📸 面部</text>
    </view>
    <view class="filter-item {{filterType === 'video' ? 'active' : ''}}" data-type="video" bindtap="switchFilter">
      <text>🎬 视频</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-wrap" wx:if="{{loading && records.length === 0}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view class="error-wrap" wx:if="{{!loading && error && records.length === 0}}">
    <text class="error-icon">📋</text>
    <text class="error-title">{{errorMsg || '加载失败'}}</text>
    <button class="btn-retry" bindtap="retryLoad" wx:if="{{errorMsg !== '暂无检测记录'}}">重新加载</button>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && !error && records.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-title">暂无检测记录</text>
    <text class="empty-desc">完成首次语音检测后，记录将显示在这里</text>
    <navigator url="/pages/index/index" open-type="switchTab" class="empty-btn">去检测</navigator>
  </view>

  <!-- 记录列表 -->
  <view class="record-list" wx:if="{{!loading && records.length > 0}}">
    <view class="record-item" 
          wx:for="{{records}}" 
          wx:key="id" 
          data-id="{{item.id}}" 
          bindtap="goReport"
          wx:if="{{filterType === 'all' || filterType === item.type}}">
      <view class="record-score-ring">
        <text class="record-score" style="color:{{item.scoreColor}}">{{item.score}}</text>
        <text class="record-score-unit">分</text>
      </view>
      <view class="record-info">
        <view class="record-top">
          <text class="record-summary">{{item.summary}}</text>
          <view class="record-type-badge">
            <text class="type-icon">{{item.typeIcon}}</text>
            <text class="type-text">{{item.typeText}}</text>
          </view>
        </view>
        <text class="record-date">{{item.date}}</text>
      </view>
      <text class="record-arrow">›</text>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{records.length > 0 && !hasMore}}">
    <text class="load-more-text">已加载全部记录</text>
  </view>

  <!-- 加载更多中 -->
  <view class="load-more" wx:if="{{loading && records.length > 0}}">
    <view class="loading-spinner-small"></view>
    <text class="load-more-text">加载中...</text>
  </view>
</view>

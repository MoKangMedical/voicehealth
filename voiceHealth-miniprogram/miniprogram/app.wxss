page{background:#0a0a0f;color:#e2e2e8;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display',sans-serif}
.container{padding:0 32rpx}.text-primary{color:#3b82f6}.text-green{color:#22c55e}.text-dim{color:rgba(255,255,255,0.45)}
.btn{display:flex;align-items:center;justify-content:center;height:96rpx;border-radius:20rpx;font-size:30rpx;font-weight:600;border:none}
.btn-primary{background:#3b82f6;color:#fff}.btn-ghost{background:rgba(255,255,255,0.04);color:#e2e2e8;border:1rpx solid rgba(255,255,255,0.06)}
.section-title{font-size:26rpx;font-weight:600;color:rgba(255,255,255,0.45);margin:40rpx 0 20rpx}

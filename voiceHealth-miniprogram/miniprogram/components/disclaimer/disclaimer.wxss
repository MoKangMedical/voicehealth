/* components/disclaimer/disclaimer.wxss */
.disclaimer-container {
  background: rgba(234, 179, 8, 0.08);
  border: 1rpx solid rgba(234, 179, 8, 0.2);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 32rpx 0;
}

.disclaimer-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.disclaimer-icon {
  font-size: 28rpx;
}

.disclaimer-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #eab308;
}

.disclaimer-content {
  padding-left: 8rpx;
}

.disclaimer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
  display: block;
  margin-bottom: 12rpx;
}

.disclaimer-points {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.point {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.4;
}

# VoiceHealth backend
VOICEHEALTH_PORT=8100

# WeChat Mini Program login
# Fill these in production so /api/v1/user/wechat-login can exchange wx.login code for openid.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Optional deployment notes
# Production API should be HTTPS and configured in WeChat Mini Program request/uploadFile domains.
VOICEHEALTH_PUBLIC_API_BASE_URL=https://voicehealth.ai

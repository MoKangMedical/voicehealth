# VoiceHealth production environment for the WeChat mini program API.
# Copy to the production server environment manager; do not commit real secrets.

VOICEHEALTH_HOST=0.0.0.0
VOICEHEALTH_PORT=8100

# WeChat mini program login. Use the real values from mp.weixin.qq.com.
WECHAT_APP_ID=wxcadcf8da37a25c0e
WECHAT_APP_SECRET=replace-with-real-app-secret

# Public HTTPS API domain configured in the WeChat mini program backend.
VOICEHEALTH_PUBLIC_BASE_URL=https://voicehealth.ai

# Browser CORS for the static web product. WeChat mini program server domains are
# configured in the WeChat public platform and are not controlled by CORS.
CORS_ORIGINS=https://voicehealth.ai
